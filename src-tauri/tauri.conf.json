{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex 用量分析",
  "version": "0.3.15",
  "identifier": "app.codex-usage.analytics",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex 用量分析",
        "width": 1536,
        "height": 1024,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "backgroundColor": "#0f151a"
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:" }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["codex-usage"] } }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installerIcon": "icons/icon.ico" } }
  }
}
